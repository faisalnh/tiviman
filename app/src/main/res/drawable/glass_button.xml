<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="0" android:exitFadeDuration="0">
    <item android:state_enabled="false"><shape><solid android:color="#0FFFFFFF" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/glass_primary" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#F0F5F7FA" /><stroke android:width="1dp" android:color="#99FFFFFF" /><corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="#0FFFFFFF" /><corners android:radius="12dp" /></shape></item>
</selector>
