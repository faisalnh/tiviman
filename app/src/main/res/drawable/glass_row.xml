<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@android:color/transparent" />
    <item android:state_pressed="true"><shape><solid android:color="@color/glass_primary" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#F0F5F7FA" /><corners android:radius="12dp" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#F0F5F7FA" /><corners android:radius="12dp" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>
